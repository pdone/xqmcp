{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python@3.11"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/mcp",
      "dest": "api/index.py"
    }
  ],
  "env": {
    "XUEQIU_TOKEN": "@xueqiu-token",
    "API_TOKEN": "@api-token"
  }
}
